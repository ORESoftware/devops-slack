# Slack app credentials. Never commit real values.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me
# Required only when SLACK_SOCKET_MODE=false.
SLACK_SIGNING_SECRET=replace-me
SLACK_SOCKET_MODE=true
PORT=3000

# Configure one or both providers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=

# Optional restrictions and resource limits.
ALLOW_PUBLIC_RESPONSES=true
INCLUDE_SLACK_IDENTIFIERS_IN_PROMPT=false
# Set to 0 to disable recent Slack context. The default sends up to five recent human-authored
# messages, without author IDs, as explicitly untrusted background context.
SLACK_CONTEXT_MESSAGE_COUNT=5
SLACK_CONTEXT_CACHE_TTL_MS=60000
SLACK_CONTEXT_MAX_CHARS=6000
SLACK_CONTEXT_CACHE_MAX_ENTRIES=500
# Context retrieval follows at most this many Slack history cursors. Each page has its own deadline.
SLACK_CONTEXT_MAX_PAGES=3
SLACK_CONTEXT_FETCH_TIMEOUT_MS=10000
OPENAI_ALLOWED_MODELS=
ANTHROPIC_ALLOWED_MODELS=
ALLOWED_SLACK_USER_IDS=
ALLOWED_SLACK_CHANNEL_IDS=
AGENT_TIMEOUT_MS=120000
MAX_OUTPUT_TOKENS=3000
MAX_PROMPT_CHARS=12000
MAX_RESPONSE_CHARS=16000
MAX_CONCURRENT_REQUESTS=4
MAX_QUEUED_REQUESTS=20
MAX_CONCURRENT_REQUESTS_PER_USER=2
MAX_QUEUED_REQUESTS_PER_USER=4
MAX_QUEUE_WAIT_MS=30000
REQUEST_DEDUPE_TTL_MS=300000
REQUEST_DEDUPE_MAX_ENTRIES=10000
SHUTDOWN_GRACE_MS=30000
LOG_LEVEL=info
